# Runtime
BELLWETHER_ENV=local
BELLWETHER_REQUIRE_CONFIGURED_DEPENDENCIES=false
BELLWETHER_ALLOWED_ORIGINS=http://localhost:3000

# Supabase tables
# Paste the Supabase connection string here for Python worker access to jobs,
# parsed evidence, findings, and regulatory review tables.
# This is not NEXT_PUBLIC_SUPABASE_URL. Use the connection string from
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Example:
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DATABASE_URL=
# Supabase API and storage
# Use the same project URL as the Next.js app. Keep the service-role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Object storage
# Production/preview should use Supabase storage.
BELLWETHER_OBJECT_STORE_MODE=supabase
BELLWETHER_STORAGE_BUCKET=bellwether-pilot-private

# Internal API auth
# Required for /internal/* endpoints in preview/production.
BELLWETHER_INTERNAL_API_TOKEN=

# AI-assisted regulatory extraction
ANTHROPIC_API_KEY=
BELLWETHER_ANTHROPIC_MODEL=claude-sonnet-4-6
BELLWETHER_ANTHROPIC_CONFLICT_MODEL=claude-opus-4-8
BELLWETHER_ANTHROPIC_MAX_TOKENS=12000
BELLWETHER_ANTHROPIC_PROMPT_CACHE=1
# Optional. Leave blank for Anthropic's default 5-minute cache. Set to 1h for longer reuse at higher cache-write cost.
BELLWETHER_ANTHROPIC_PROMPT_CACHE_TTL=1h
