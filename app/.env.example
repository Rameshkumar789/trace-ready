NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BELLWETHER_AUTH_SECRET=
BELLWETHER_INTERNAL_API_TOKEN=
# The app calls the Python backend SYNCHRONOUSLY on upload to run parse + rule execution
# (there is no cron/queue worker). In production this MUST be the deployed Python service URL
# (e.g. https://<your-ingestion>.vercel.app), not localhost, or uploads will not be processed.
BELLWETHER_PYTHON_API_URL=http://127.0.0.1:8000
SUPABASE_PRIVATE_BUCKET=bellwether-pilot-private

# Optional for local upload queueing when you want Prisma direct access to Supabase tables.
# If blank, uploads can queue through Supabase REST using SUPABASE_SERVICE_ROLE_KEY.
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

OPENAI_API_KEY=
